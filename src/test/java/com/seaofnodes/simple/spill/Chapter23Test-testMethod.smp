// A hypothetical scanner class
struct Scan {
    int !x;
    u8[~] buf;
    new Scan={ u8[~] b -> buf=b; };
    // Skip whitespace
    val skip = { ->
        while( buf[x] <= ' ' )
            x++;
    };
    val require = { u8 ch ->
        skip();
        buf[x++]==ch;
    };
};
Scan !s = new Scan("  [1,2]");
return s.require('[');
