struct aryi64 {
    u32 !len = 0;
    i64[] !buf;

    new aryi64 = { i64[] b -> buf = b; };

    val _grow = { int len2 ->
        if( len+len2 < buf# ) return self;
        int newlen = buf# * 2;
        while( len+len2 >= newlen ) newlen *= 2;
        i64[] !buf2 = new i64[newlen];
        for( int i=0; i<buf#; i++ )
            buf2[i] = buf[i];
        buf = buf2;
        self;
    };

    val add = { i64 c ->
        _grow(1).buf[len++] = c;
        self;
    };

    val str = { ->
        var str = new aryu8(new u8[1]).add('[');
        for( int i=0; i<len; i++ )
            str.num(buf[i]).add(',').add(' ');
        str.undo(2).add(']');
    };
};
